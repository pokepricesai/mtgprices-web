# MTGPrices, environment variable names
# -------------------------------------
# Names and explanatory comments only. NEVER commit real values.
#
# Scopes
#   * NEXT_PUBLIC_* vars are inlined into the browser bundle at build
#     time. Treat their values as effectively public.
#   * Everything else is server-only.

# ── Public ──────────────────────────────────────────────────────────

# [REQUIRED] Supabase REST base URL. Shared with PokePrices, same project.
NEXT_PUBLIC_SUPABASE_URL=

# [REQUIRED] Supabase anon JWT for public reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [optional] Google Analytics 4 measurement ID (G-XXXXXXX). Analytics
# is disabled entirely when this is unset.
NEXT_PUBLIC_GA_ID=

# [optional] Public flag that mirrors AI_BUILD_ENABLED so the New Deck
# client can conditionally render the "Build with AI" section. The
# server route still enforces the real check via AI_BUILD_ENABLED.
NEXT_PUBLIC_AI_BUILD_ENABLED=

# ── Server, core ────────────────────────────────────────────────────

# [REQUIRED] Supabase service-role JWT. Used exclusively from server
# components / route handlers via src/lib/supabaseService.ts, which is
# guarded by `import 'server-only'`. Must be the legacy eyJ... JWT
# format, not sb_publishable_.
SUPABASE_SERVICE_ROLE_KEY=

# [pre-launch flag] Set to 'true' when the site is ready for public
# indexing. Everything else keeps the site noindex and stays out of
# sitemaps.
SITE_LAUNCHED=

# ── Server, AI ──────────────────────────────────────────────────────

# [required for AI] Vercel AI Gateway key. Used by src/lib/ai/*.
# Without it, `aiConfigured()` returns false and every AI route
# fails fast.
AI_GATEWAY_API_KEY=

# [optional] Override model strings passed to the Gateway. Default
# for both tiers is 'anthropic/claude-sonnet-5'.
AI_MODEL_CHEAP=
AI_MODEL_REASONING=

# [optional] Per-user daily quotas enforced by src/lib/ai/rate-limit.ts.
# Defaults: 6 operations, $0.50.
AI_DAILY_OPS_LIMIT=
AI_DAILY_CENTS_LIMIT=

# [optional] Server-side unlock for /api/decks/new-ai. Also mirror
# NEXT_PUBLIC_AI_BUILD_ENABLED for the client to render the entry point.
AI_BUILD_ENABLED=

# ── Server, eBay affiliate ──────────────────────────────────────────
# Nothing tracked or attributed unless BOTH the campaign ID and
# EBAY_AFFILIATE_ENABLED are set. See src/lib/mtg/ebay-links.ts.

# [optional] eBay Partner Network Campaign ID. Without it, eBay links
# are still generated but as plain search URLs with no tracking params.
EBAY_EPN_CAMPAIGN_ID=

# [optional] Master switch. Must be 'true' to inject the campid and
# custom tracking params into rendered eBay URLs.
EBAY_AFFILIATE_ENABLED=

# [optional] Fallback marketplace when no visitor country is available.
# One of: US, GB, DE, FR, IT, ES, AU, CA. Defaults to US.
EBAY_DEFAULT_MARKETPLACE=

# [optional] Custom link identifier passed through to eBay analytics
# (customid / mkevt / etc.). Free-form, keep short.
EBAY_CUSTOM_ID=

# ── Server, email + queue (unchanged) ───────────────────────────────
# See existing routes in src/app/api/ for consumers. Kept out of this
# example when they are optional pre-launch.
