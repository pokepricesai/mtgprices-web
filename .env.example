# MTGPrices — environment variable names
# ---------------------------------------
# Names and explanatory comments only. NEVER commit real values.
#
# Scopes
#   * NEXT_PUBLIC_* vars are inlined into the browser bundle at build
#     time. Treat their values as effectively public.
#   * Everything else is server-only.

# ── Public ──────────────────────────────────────────────────────────────────

# [REQUIRED] Supabase REST base URL. Shared with PokePrices — same project.
NEXT_PUBLIC_SUPABASE_URL=

# [REQUIRED] Supabase anon JWT for public reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [optional] Google Analytics 4 measurement ID (G-XXXXXXX). Analytics is
# disabled entirely when this is unset.
NEXT_PUBLIC_GA_ID=

# ── Server-only ─────────────────────────────────────────────────────────────

# [REQUIRED] Supabase service-role JWT. Used exclusively from server
# components / route handlers via src/lib/supabaseService.ts, which is
# guarded by `import 'server-only'`. Must be the legacy eyJ... JWT
# format, not sb_publishable_.
SUPABASE_SERVICE_ROLE_KEY=
